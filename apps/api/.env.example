# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://pitstop:pitstop@localhost:5433/pitstop?schema=public"

# --- API --------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (REST + WebSocket).
# In production this must include your Vercel domain.
CORS_ORIGINS="http://localhost:3000"

# --- Auth -------------------------------------------------------------------
# Generate a real one for production:  openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="8h"

# --- Live ops simulator -----------------------------------------------------
# Advances booking statuses on a timer so the dashboard has live traffic.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=7000
