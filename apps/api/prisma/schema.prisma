// PitStop Ops — data model
//
// Money note: `amount` / `basePrice` are whole Indian rupees stored as Int.
// Service pricing in this domain has no sub-rupee component, so Int avoids both
// floating-point drift and Prisma's Decimal serialisation overhead, and lets the
// revenue aggregates be plain SQL SUM()s.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPS
}

enum BookingStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MechanicStatus {
  AVAILABLE
  ON_JOB
  OFF_DUTY
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

/// Dashboard operators. Seeded, not self-registerable — this is an internal tool.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OPS)
  createdAt    DateTime @default(now())

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  city      String
  createdAt DateTime @default(now())

  vehicles Vehicle[]
  bookings Booking[]

  @@index([createdAt])
  @@index([city])
  @@map("customers")
}

model Vehicle {
  id         String   @id @default(cuid())
  customerId String
  make       String
  model      String
  year       Int
  regNo      String   @unique
  fuelType   FuelType

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([customerId])
  @@map("vehicles")
}

model Mechanic {
  id             String         @id @default(cuid())
  name           String
  phone          String
  specialization String
  status         MechanicStatus @default(AVAILABLE)
  rating         Float          @default(4.5)
  jobsCompleted  Int            @default(0)
  city           String
  /// Approximate live position, used by the mechanics view (and a future map).
  lat            Float
  lng            Float
  hiredAt        DateTime

  bookings Booking[]

  @@index([status])
  @@index([city])
  @@map("mechanics")
}

model Service {
  id           String @id @default(cuid())
  name         String
  category     String
  basePrice    Int
  durationMins Int

  bookings Booking[]

  @@index([category])
  @@map("services")
}

model Booking {
  id          String        @id @default(cuid())
  /// Human-facing reference shown in the UI and searchable, e.g. BK-2026-0417.
  code        String        @unique
  customerId  String
  vehicleId   String
  serviceId   String
  mechanicId  String?
  status      BookingStatus @default(PENDING)
  amount      Int
  city        String
  notes       String?
  scheduledAt DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  service  Service        @relation(fields: [serviceId], references: [id])
  mechanic Mechanic?      @relation(fields: [mechanicId], references: [id])
  events   BookingEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([scheduledAt])
  @@index([mechanicId])
  @@index([customerId])
  @@index([serviceId])
  // Backs the default list view: filter by status, order by newest.
  @@index([status, createdAt])
  @@map("bookings")
}

/// Append-only audit trail of every status transition. Powers the booking
/// timeline and the live activity feed — the feed shows real rows, not toasts
/// that vanish on refresh.
model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  fromStatus BookingStatus?
  toStatus   BookingStatus
  note       String?
  /// Who caused it: "system" for simulator traffic, otherwise the user's email.
  actor      String         @default("system")
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([createdAt])
  @@map("booking_events")
}
