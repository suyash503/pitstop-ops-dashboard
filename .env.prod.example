# Copy to .env on the EC2 box: cp .env.prod.example .env
# docker compose -f docker-compose.prod.yml reads it automatically.

# --- Database (internal to the compose network) -----------------------------
POSTGRES_USER=pitstop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=pitstop

# --- Public hostname --------------------------------------------------------
# The DuckDNS subdomain pointing at this instance's Elastic IP.
DOMAIN=your-subdomain.duckdns.org
LETSENCRYPT_EMAIL=you@example.com

# --- API --------------------------------------------------------------------
# Must include the Vercel domain, or the browser blocks every request.
CORS_ORIGINS=https://your-app.vercel.app
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h

SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=7000
